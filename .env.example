# Copy to .env.local (never committed) and fill in. Used by scripts/setup.sh and scripts/deploy.sh.
#
# Cloudflare → (edbuddy account) → right-hand sidebar on any page → Account ID
CLOUDFLARE_ACCOUNT_ID=
#
# Cloudflare → My Profile → API Tokens → Create Token → Custom token
#   Permissions: Account · Workers R2 Storage · Edit
#   (optional, lets setup connect cdn.edbuddypro.com for you: Zone · Zone · Read  and  Zone · DNS · Edit,
#    Zone Resources: edbuddypro.com)
CLOUDFLARE_API_TOKEN=
#
# Optional: Cloudflare → edbuddypro.com → Overview → API → Zone ID
CF_ZONE_ID=
